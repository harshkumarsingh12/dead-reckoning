# ---- Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.env.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Data: raw datasets and recordings never enter git.
# scripts/fetch_datasets.py reproduces them. See data/README.md.
data/**
!data/README.md
!data/golden/
!data/golden/README.md
!data/golden/*.jsonl.gz

# ---- Map tiles: regenerate with scripts/make_tiles.py, do not commit (100s of MB)
*.mbtiles
tiles/

# ---- Models: only the released .onnx is tracked (via LFS). Checkpoints are not.
*.pt
*.pth
*.ckpt
runs/
lightning_logs/
wandb/

# ---- Notebooks
notebooks/**
!notebooks/README.md
.ipynb_checkpoints/

# ---- Node / web
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# ---- Android
apps/android/local.properties
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/captures/
*.apk
*.aab
*.keystore
*.jks
keystore.properties

# ---- Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
