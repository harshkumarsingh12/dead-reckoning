* text=auto eol=lf

*.py     text diff=python
*.md     text
*.yml    text
*.yaml   text
*.kt     text
*.kts    text
*.ts     text
*.tsx    text
*.gradle text

# Shell scripts and the Gradle wrapper must stay LF and executable on Linux CI.
*.sh          text eol=lf
gradlew       text eol=lf

*.bat         text eol=crlf
*.ps1         text eol=crlf

# Binary. Git LFS is used sparingly — the free tier is 1 GB and blowing it
# mid-hackathon is a self-inflicted outage. Only the released model and one
# small golden run are tracked; raw datasets and tiles are regenerated, not stored.
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.onnx.data   filter=lfs diff=lfs merge=lfs -text
*.jar         binary
*.png         binary
*.jpg         binary
*.pdf         binary
